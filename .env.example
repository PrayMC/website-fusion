# Copy to .env.local while developing; on Vercel, set these in the project's environment variables.

# The Fusion backend (Fusion/backend, a Cloudflare Worker). "sample" (or empty under npm run dev): built-in sample data.
# Empty under npm start: the site shows "can't load" rather than made-up rankings.
FUSION_API_URL=https://fusion-api.example.workers.dev
# The backend's API_TOKEN, if it has one
FUSION_API_TOKEN=

# Shown in the top bar; built into the pages, so rebuild after changing them.
NEXT_PUBLIC_SERVER_NAME=Fusion
NEXT_PUBLIC_SERVER_ADDRESS=
